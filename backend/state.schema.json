{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "State Schema",
  "description": "Schema for state.json runtime state file",
  "type": "object",
  "required": ["userStars", "routineExecutions", "taskExecutions", "spendings", "exerciseSessions"],
  "additionalProperties": false,
  "properties": {
    "exerciseSessions": {
      "type": "array",
      "description": "Game sessions of school exercises",
      "items": {
        "type": "object",
        "required": ["id", "playerIds", "categories", "totalRounds", "currentRound", "questionsPerRound", "currentQuestionIndex", "exerciseIds", "answers", "startedAt", "totalStarsEarned"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
          "playerIds": { "type": "array", "items": { "type": "string" } },
          "categories": { "type": "array", "items": { "type": "string" } },
          "totalRounds": { "type": "integer", "minimum": 1 },
          "currentRound": { "type": "integer", "minimum": 1 },
          "questionsPerRound": { "type": "integer", "minimum": 1 },
          "currentQuestionIndex": { "type": "integer", "minimum": 0 },
          "exerciseIds": { "type": "array", "items": { "type": "string" } },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["exerciseId", "status", "answeredAt", "earnedStars"],
                "properties": {
                  "exerciseId": { "type": "string" },
                  "status": { "type": "string", "enum": ["correct", "incorrect"] },
                  "answeredAt": { "type": "string" },
                  "earnedStars": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "startedAt": { "type": "string" },
          "completedAt": { "type": "string" },
          "totalStarsEarned": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "exerciseAssignments": {
      "type": "array",
      "description": "Per-user daily school exercise assignments (chore-like)",
      "items": {
        "type": "object",
        "required": ["id", "userId", "exerciseId", "date", "status", "attempts", "assignedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
          "userId": { "type": "string" },
          "exerciseId": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "status": { "type": "string", "enum": ["pending", "completed"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "assignedAt": { "type": "string" },
          "completedAt": { "type": "string" },
          "starsAwarded": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "starTransfers": {
      "type": "array",
      "description": "History of star transfers between users",
      "items": {
        "type": "object",
        "required": ["id", "fromUserId", "toUserId", "amount", "createdAt", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the transfer"
          },
          "fromUserId": {
            "type": "string",
            "description": "Reference to sender user ID"
          },
          "toUserId": {
            "type": "string",
            "description": "Reference to receiver user ID"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of stars to transfer"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp when transfer was requested"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "cancelled"],
            "description": "Current status of the transfer"
          },
          "resolvedAt": {
            "type": "string",
            "description": "ISO timestamp when transfer was resolved (approved/rejected/cancelled)"
          }
        }
      }
    },
    "choreInstances": {
      "type": "array",
      "description": "Chore instance lifecycle tracking",
      "items": {
        "type": "object",
        "required": ["id", "choreId", "status", "availableAt", "expiresAt"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the chore instance"
          },
          "choreId": {
            "type": "string",
            "description": "Reference to chore ID"
          },
          "status": {
            "type": "string",
            "enum": ["available", "claimed", "attempted", "confirmed", "rejected", "expired"],
            "description": "Current status of the chore instance"
          },
          "availableAt": {
            "type": "string",
            "description": "ISO timestamp when chore became available"
          },
          "expiresAt": {
            "type": "string",
            "description": "ISO timestamp when chore expires"
          },
          "claimedBy": {
            "type": "string",
            "description": "User ID who claimed this chore"
          },
          "claimedAt": {
            "type": "string",
            "description": "ISO timestamp when chore was claimed"
          },
          "attemptedAt": {
            "type": "string",
            "description": "ISO timestamp when user marked chore as done"
          },
          "confirmedAt": {
            "type": "string",
            "description": "ISO timestamp when parent confirmed completion"
          },
          "rejectedAt": {
            "type": "string",
            "description": "ISO timestamp when parent rejected attempt"
          },
          "starsAwarded": {
            "type": "integer",
            "minimum": 0,
            "description": "Stars awarded for this chore (can differ from defaultStars)"
          }
        }
      }
    },
    "userStars": {
      "type": "object",
      "description": "Map of user IDs to their current star balance",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "type": "integer",
          "minimum": 0,
          "description": "Star balance for user"
        }
      },
      "additionalProperties": false
    },
    "routineExecutions": {
      "type": "array",
      "description": "History of routine execution sessions",
      "items": {
        "type": "object",
        "required": ["id", "userId", "routineId", "startedAt", "totalStars"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the execution"
          },
          "userId": {
            "type": "string",
            "description": "Reference to user ID"
          },
          "routineId": {
            "type": "string",
            "description": "Reference to routine ID"
          },
          "startedAt": {
            "type": "string",
            "description": "ISO timestamp when routine started"
          },
          "totalStars": {
            "type": "integer",
            "minimum": 0,
            "description": "Total stars earned in this routine"
          },
          "completedAt": {
            "type": "string",
            "description": "ISO timestamp when routine completed"
          }
        }
      }
    },
    "taskExecutions": {
      "type": "array",
      "description": "History of individual task completions",
      "items": {
        "type": "object",
        "required": ["id", "executionId", "taskId", "duration", "isOnTime", "completedAt"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the task execution"
          },
          "executionId": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "Reference to routine execution ID"
          },
          "taskId": {
            "type": "string",
            "description": "Reference to task ID"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "description": "Time taken in seconds"
          },
          "isOnTime": {
            "type": "boolean",
            "description": "Whether task was completed within time limit"
          },
          "completedAt": {
            "type": "string",
            "description": "ISO timestamp when task completed"
          }
        }
      }
    },
    "spendings": {
      "type": "array",
      "description": "History of reward redemptions",
      "items": {
        "type": "object",
        "required": ["id", "userId", "rewardId", "cost", "createdAt", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the spending"
          },
          "userId": {
            "type": "string",
            "description": "Reference to user ID"
          },
          "rewardId": {
            "type": "string",
            "description": "Reference to reward ID"
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "description": "Star cost of the reward"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp when reward was requested"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "done", "revoked"],
            "description": "Current status of the spending"
          }
        }
      }
    }
  }
}

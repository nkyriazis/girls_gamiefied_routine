{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "State Schema",
  "description": "Schema for state.json runtime state file",
  "type": "object",
  "required": ["userStars", "routineExecutions", "taskExecutions", "spendings"],
  "additionalProperties": false,
  "properties": {
    "starTransfers": {
      "type": "array",
      "description": "History of star transfers between users",
      "items": {
        "type": "object",
        "required": ["id", "fromUserId", "toUserId", "amount", "createdAt", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the transfer"
          },
          "fromUserId": {
            "type": "string",
            "description": "Reference to sender user ID"
          },
          "toUserId": {
            "type": "string",
            "description": "Reference to receiver user ID"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of stars to transfer"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp when transfer was requested"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "cancelled"],
            "description": "Current status of the transfer"
          },
          "resolvedAt": {
            "type": "string",
            "description": "ISO timestamp when transfer was resolved (approved/rejected/cancelled)"
          }
        }
      }
    },
    "exerciseInstances": {
      "type": "array",
      "description": "Exercise instance lifecycle tracking",
      "items": {
        "type": "object",
        "required": ["id", "exerciseId", "userId", "status", "startedAt", "attempts"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the exercise instance"
          },
          "exerciseId": {
            "type": "string",
            "description": "Reference to exercise ID"
          },
          "userId": {
            "type": "string",
            "description": "User ID attempting the exercise"
          },
          "status": {
            "type": "string",
            "enum": ["available", "active", "completed", "failed"],
            "description": "Current status of the exercise instance"
          },
          "startedAt": {
            "type": "string",
            "description": "ISO timestamp when exercise was started"
          },
          "completedAt": {
            "type": "string",
            "description": "ISO timestamp when exercise was completed"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of attempts made"
          },
          "starsAwarded": {
            "type": "integer",
            "minimum": 0,
            "description": "Stars awarded for completing the exercise"
          }
        }
      }
    },
    "choreInstances": {
      "type": "array",
      "description": "Chore instance lifecycle tracking",
      "items": {
        "type": "object",
        "required": ["id", "choreId", "status", "availableAt", "expiresAt"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the chore instance"
          },
          "choreId": {
            "type": "string",
            "description": "Reference to chore ID"
          },
          "status": {
            "type": "string",
            "enum": ["available", "claimed", "attempted", "confirmed", "rejected", "expired"],
            "description": "Current status of the chore instance"
          },
          "availableAt": {
            "type": "string",
            "description": "ISO timestamp when chore became available"
          },
          "expiresAt": {
            "type": "string",
            "description": "ISO timestamp when chore expires"
          },
          "claimedBy": {
            "type": "string",
            "description": "User ID who claimed this chore"
          },
          "claimedAt": {
            "type": "string",
            "description": "ISO timestamp when chore was claimed"
          },
          "attemptedAt": {
            "type": "string",
            "description": "ISO timestamp when user marked chore as done"
          },
          "confirmedAt": {
            "type": "string",
            "description": "ISO timestamp when parent confirmed completion"
          },
          "rejectedAt": {
            "type": "string",
            "description": "ISO timestamp when parent rejected attempt"
          },
          "starsAwarded": {
            "type": "integer",
            "minimum": 0,
            "description": "Stars awarded for this chore (can differ from defaultStars)"
          }
        }
      }
    },
    "userStars": {
      "type": "object",
      "description": "Map of user IDs to their current star balance",
      "patternProperties": {
        "^[a-zA-Z0-9-_]+$": {
          "type": "integer",
          "minimum": 0,
          "description": "Star balance for user"
        }
      },
      "additionalProperties": false
    },
    "routineExecutions": {
      "type": "array",
      "description": "History of routine execution sessions",
      "items": {
        "type": "object",
        "required": ["id", "userId", "routineId", "startedAt", "totalStars"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the execution"
          },
          "userId": {
            "type": "string",
            "description": "Reference to user ID"
          },
          "routineId": {
            "type": "string",
            "description": "Reference to routine ID"
          },
          "startedAt": {
            "type": "string",
            "description": "ISO timestamp when routine started"
          },
          "totalStars": {
            "type": "integer",
            "minimum": 0,
            "description": "Total stars earned in this routine"
          },
          "completedAt": {
            "type": "string",
            "description": "ISO timestamp when routine completed"
          }
        }
      }
    },
    "taskExecutions": {
      "type": "array",
      "description": "History of individual task completions",
      "items": {
        "type": "object",
        "required": ["id", "executionId", "taskId", "duration", "isOnTime", "completedAt"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the task execution"
          },
          "executionId": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "Reference to routine execution ID"
          },
          "taskId": {
            "type": "string",
            "description": "Reference to task ID"
          },
          "duration": {
            "type": "integer",
            "minimum": 0,
            "description": "Time taken in seconds"
          },
          "isOnTime": {
            "type": "boolean",
            "description": "Whether task was completed within time limit"
          },
          "completedAt": {
            "type": "string",
            "description": "ISO timestamp when task completed"
          }
        }
      }
    },
    "spendings": {
      "type": "array",
      "description": "History of reward redemptions",
      "items": {
        "type": "object",
        "required": ["id", "userId", "rewardId", "cost", "createdAt", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$",
            "description": "UUID of the spending"
          },
          "userId": {
            "type": "string",
            "description": "Reference to user ID"
          },
          "rewardId": {
            "type": "string",
            "description": "Reference to reward ID"
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "description": "Star cost of the reward"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO timestamp when reward was requested"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "done", "revoked"],
            "description": "Current status of the spending"
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Routine Configuration Schema",
  "description": "Schema for data.json configuration file",
  "type": "object",
  "required": ["tasks", "routines", "routineTasks", "users", "settings", "routineAssignments", "flows", "schedules", "rewards"],
  "additionalProperties": false,
  "properties": {
    "exercises": {
      "type": "array",
      "description": "Educational mini-games for earning stars",
      "items": {
        "type": "object",
        "required": ["id", "title", "icon", "difficulty", "level", "stars", "content"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique exercise identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display name for the exercise"
          },
          "icon": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["emoji", "image"],
                "description": "Icon type: emoji or image (uploaded filename)"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Emoji character or uploaded filename (auto-resolves to /uploads/)"
              }
            }
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "description": "Difficulty level of the exercise"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "School grade level (1-10) for content generation"
          },
          "stars": {
            "type": "integer",
            "minimum": 1,
            "description": "Star reward for correct completion"
          },
          "challengeMode": {
            "type": "string",
            "enum": ["untimed", "timed"],
            "description": "Challenge mode: untimed (fail after maxErrors) or timed (block until correct with timeout)"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 10,
            "description": "Optional timeout in seconds for timed challenges"
          },
          "maxErrors": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum errors before failing (for untimed mode, default: 3)"
          },
          "availabilityCron": {
            "type": "string",
            "pattern": "^[\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+$",
            "description": "Optional cron expression for when exercise becomes available"
          },
          "eligibleUsers": {
            "type": "array",
            "description": "Optional list of user IDs who can attempt this exercise. If omitted, all users can attempt.",
            "items": {
              "type": "string",
              "description": "Reference to user ID"
            }
          },
          "content": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "word", "hiddenIndices"],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["spell-fill"]
                  },
                  "word": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The complete word"
                  },
                  "hiddenIndices": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "description": "Indices of letters to hide (0-based)"
                  },
                  "hint": {
                    "type": "string",
                    "description": "Optional hint"
                  }
                }
              },
              {
                "type": "object",
                "required": ["type", "question", "options", "correctIndex"],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["grammar-choice"]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The question text"
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 2,
                    "description": "Array of options to choose from"
                  },
                  "correctIndex": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Index of the correct answer (0-based)"
                  }
                }
              },
              {
                "type": "object",
                "required": ["type", "operation", "num1", "num2"],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["math-simple"]
                  },
                  "operation": {
                    "type": "string",
                    "enum": ["+", "-", "*", "/"]
                  },
                  "num1": {
                    "type": "number"
                  },
                  "num2": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": ["type", "operation", "num1", "num2"],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["math-vertical"]
                  },
                  "operation": {
                    "type": "string",
                    "enum": ["+", "-", "*"]
                  },
                  "num1": {
                    "type": "number"
                  },
                  "num2": {
                    "type": "number"
                  },
                  "requireCarries": {
                    "type": "boolean",
                    "description": "Whether to require carry/borrow input for interactive step-by-step process"
                  },
                  "showHelpers": {
                    "type": "boolean",
                    "description": "Show helper lines, partial sums, and visual aids"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "chores": {
      "type": "array",
      "description": "Household chores and bonus activities that children can claim and complete for stars",
      "items": {
        "type": "object",
        "required": ["id", "title", "icon", "defaultStars", "availabilityCron", "expirationHours"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique chore/activity identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display name for the chore/activity"
          },
          "icon": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["emoji", "image"],
                "description": "Icon type: emoji or image (uploaded filename)"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Emoji character or uploaded filename (auto-resolves to /uploads/)"
              }
            }
          },
          "defaultStars": {
            "type": "integer",
            "minimum": 1,
            "description": "Default star reward for completing chore/activity"
          },
          "availabilityCron": {
            "type": "string",
            "pattern": "^[\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+$",
            "description": "Cron expression for when chore/activity becomes available (5 fields: minute hour day month weekday)"
          },
          "expirationHours": {
            "type": "number",
            "minimum": 0.5,
            "description": "Hours after availability when chore/activity expires if not completed"
          },
          "eligibleUsers": {
            "type": "array",
            "description": "Optional list of user IDs who can claim this chore/activity. If omitted, all users can claim.",
            "items": {
              "type": "string",
              "description": "Reference to user ID"
            }
          },
          "category": {
            "type": "string",
            "enum": ["chore", "bonus"],
            "default": "chore",
            "description": "Category: 'chore' for household tasks, 'bonus' for school/outside achievements"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "Library of reusable tasks",
      "items": {
        "type": "object",
        "required": ["id", "title", "icon", "stars"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique task identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display name for the task"
          },
          "icon": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["emoji", "image"],
                "description": "Icon type: emoji (Unicode character) or image (uploaded file from /uploads)"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Emoji character or icon name"
              }
            }
          },
          "stars": {
            "type": "integer",
            "minimum": 0,
            "description": "Star reward for completing task on time"
          },
          "lateStars": {
            "type": "integer",
            "minimum": 0,
            "description": "Star reward for completing task after time runs out (default: 0)"
          }
        }
      }
    },
    "routines": {
      "type": "array",
      "description": "Template routines (e.g., Morning, Evening)",
      "items": {
        "type": "object",
        "required": ["id", "title", "themeColor", "icon"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique routine identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display name for the routine"
          },
          "themeColor": {
            "type": "string",
            "description": "CSS color value or var()"
          },
          "icon": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["emoji", "image"],
                "description": "Icon type: emoji or image (uploaded filename)"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Emoji character or uploaded filename (auto-resolves to /uploads/)"
              }
            }
          }
        }
      }
    },
    "routineTasks": {
      "type": "array",
      "description": "Join table mapping routines to tasks with order and duration",
      "items": {
        "type": "object",
        "required": ["id", "routineId", "taskId", "order", "durationSeconds"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique routine-task mapping identifier"
          },
          "routineId": {
            "type": "string",
            "description": "Reference to routine ID"
          },
          "taskId": {
            "type": "string",
            "description": "Reference to task ID"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "description": "Sequence order within routine"
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Time limit for task completion"
          }
        }
      }
    },
    "users": {
      "type": "array",
      "description": "Children profiles",
      "items": {
        "type": "object",
        "required": ["id", "name", "avatar", "color"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique user identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Child's display name"
          },
          "avatar": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["emoji", "image"],
                "description": "Avatar type: emoji or image (uploaded filename)"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Emoji character or uploaded filename (auto-resolves to /uploads/)"
              }
            }
          },
          "color": {
            "type": "string",
            "description": "CSS color value or var()"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": ["timezone"],
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z]+/[A-Za-z_]+$",
          "description": "IANA timezone identifier (e.g., Europe/Athens)"
        }
      }
    },
    "routineAssignments": {
      "type": "array",
      "description": "User-specific routine instances",
      "items": {
        "type": "object",
        "required": ["id", "userId", "routineId"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique assignment identifier"
          },
          "userId": {
            "type": "string",
            "description": "Reference to user ID"
          },
          "routineId": {
            "type": "string",
            "description": "Reference to routine ID"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "description": "Multi-step sequences (alarm + parallel routines)",
      "items": {
        "type": "object",
        "required": ["id", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique flow identifier"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["type", "props"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["alarm"]
                    },
                    "props": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "sound": {
                          "oneOf": [
                            {
                              "type": "string",
                              "enum": ["melody", "beep"],
                              "description": "Built-in sound: melody (wake-up tune) or beep (simple alarm)"
                            },
                            {
                              "type": "object",
                              "required": ["type", "value"],
                              "additionalProperties": false,
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "enum": ["upload"],
                                  "description": "Custom uploaded audio file"
                                },
                                "value": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Uploaded filename (from /uploads/)"
                                }
                              }
                            }
                          ]
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Alarm title text"
                        },
                        "message": {
                          "type": "string",
                          "description": "Optional message below title"
                        },
                        "icon": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Emoji icon for the alarm"
                        },
                        "dismissText": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Text for the dismiss button"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "actions"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["parallel"]
                    },
                    "actions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "required": ["type", "userId", "routineId"],
                            "additionalProperties": false,
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": ["routine"]
                              },
                              "userId": {
                                "type": "string",
                                "description": "Reference to user ID"
                              },
                              "routineId": {
                                "type": "string",
                                "description": "Reference to routine assignment ID"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": ["type", "flowId"],
                            "additionalProperties": false,
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": ["flow"]
                              },
                              "flowId": {
                                "type": "string",
                                "description": "Reference to flow ID"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "schedules": {
      "type": "array",
      "description": "Cron-based triggers",
      "items": {
        "type": "object",
        "required": ["id", "cron", "type", "targetId"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique schedule identifier"
          },
          "cron": {
            "type": "string",
            "pattern": "^[\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+ [\\d\\*\\-,/]+$",
            "description": "Cron expression (5 fields: minute hour day month weekday)"
          },
          "type": {
            "type": "string",
            "enum": ["flow", "routine"],
            "description": "Target type to trigger"
          },
          "targetId": {
            "type": "string",
            "description": "Flow ID or routine assignment ID"
          }
        }
      }
    },
    "rewards": {
      "type": "array",
      "description": "Redeemable rewards with star costs",
      "items": {
        "type": "object",
        "required": ["id", "title", "icon", "cost"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Unique reward identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display name for reward"
          },
          "icon": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["emoji", "image"],
                "description": "Icon type: emoji or image (uploaded filename)"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "description": "Emoji character or uploaded filename (auto-resolves to /uploads/)"
              }
            }
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "description": "Star cost to redeem"
          }
        }
      }
    }
  }
}

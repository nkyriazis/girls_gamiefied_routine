{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "School Exercises Schema",
  "description": "Schema for exercises.json configuration file",
  "type": "object",
  "required": ["exercises"],
  "definitions": {
    "problemStep": {
      "type": "object",
      "required": ["kind", "phase", "prompt"],
      "properties": {
        "kind": { "enum": ["tag", "choice", "numbers", "order", "paint", "calc"] },
        "phase": { "enum": ["read", "plan", "solve", "check"], "description": "Which part of the method the step belongs to" },
        "prompt": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "description": "Shown after a wrong try" },
        "story": { "type": "string", "description": "Replaces the story while this step is on screen (e.g. the story without its numbers)" },
        "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "correctIndex": { "type": "integer", "minimum": 0 },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "answer"],
            "additionalProperties": false,
            "properties": { "label": { "type": "string" }, "answer": { "type": "number" }, "unit": { "type": "string" } }
          }
        },
        "items": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "targets": {
          "type": "array",
          "minItems": 2,
          "description": "Paint: the story's marked phrases, in order, as word indexes (core words and span)",
          "items": {
            "type": "object",
            "required": ["role", "words", "span"],
            "additionalProperties": false,
            "properties": {
              "role": { "enum": ["known", "sought", "extra"] },
              "words": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
              "span": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } },
              "need": { "type": "integer", "minimum": 1, "description": "How many of the words must be painted (all when absent)" }
            }
          }
        },
        "quantities": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "value", "label"],
            "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "value": { "type": "number" }, "label": { "type": "string" }, "unit": { "type": "string" } }
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["out", "op", "a", "b"],
            "additionalProperties": false,
            "properties": { "out": { "type": "string" }, "op": { "enum": ["+", "−", "×", ":"] }, "a": { "type": "string" }, "b": { "type": "string" } }
          }
        },
        "given": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sought": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "kind": { "const": "choice" } } }, "then": { "required": ["options", "correctIndex"] } },
        { "if": { "properties": { "kind": { "const": "numbers" } } }, "then": { "required": ["rows"] } },
        { "if": { "properties": { "kind": { "const": "order" } } }, "then": { "required": ["items"] } },
        { "if": { "properties": { "kind": { "const": "paint" } } }, "then": { "required": ["targets"] } },
        { "if": { "properties": { "kind": { "const": "calc" } } }, "then": { "required": ["quantities", "relations", "given", "sought"] } }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "icon": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" }
        }
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "Multiple Choice",
            "type": "object",
            "required": ["id", "type", "category", "title", "question", "options", "correctIndex", "stars"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "multiple-choice" },
              "category": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "figure": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" },
              "question": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              },
              "correctIndex": { "type": "integer", "minimum": 0 },
              "stars": { "type": "integer", "minimum": 1 },
              "userIds": { "type": "array", "items": { "type": "string" }, "description": "If set, only these user IDs can play this exercise. If omitted, all users can play." },
              "template": { "type": "boolean" },
              "source": { "type": "string", "description": "Where in the textbooks it comes from" },
              "generatorParams": { "type": "object" }
            }
          },
          {
            "title": "Match Pairs",
            "type": "object",
            "required": ["id", "type", "category", "title", "pairs", "stars"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "match-pairs" },
              "category": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "figure": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" },
              "pairs": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["left", "right"],
                  "properties": {
                    "left": { "type": "string" },
                    "right": { "type": "string" }
                  }
                }
              },
              "stars": { "type": "integer", "minimum": 1 },
              "userIds": { "type": "array", "items": { "type": "string" }, "description": "If set, only these user IDs can play this exercise. If omitted, all users can play." },
              "template": { "type": "boolean" },
              "source": { "type": "string", "description": "Where in the textbooks it comes from" },
              "generatorParams": { "type": "object" }
            }
          },
          {
            "title": "Ordering",
            "type": "object",
            "required": ["id", "type", "category", "title", "items", "stars"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "ordering" },
              "category": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "figure": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" },
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["id", "content"],
                  "properties": {
                    "id": { "type": "string" },
                    "content": { "type": "string" }
                  }
                }
              },
              "stars": { "type": "integer", "minimum": 1 },
              "userIds": { "type": "array", "items": { "type": "string" }, "description": "If set, only these user IDs can play this exercise. If omitted, all users can play." },
              "template": { "type": "boolean" },
              "source": { "type": "string", "description": "Where in the textbooks it comes from" },
              "generatorParams": { "type": "object" }
            }
          },
          {
            "title": "True/False",
            "type": "object",
            "required": ["id", "type", "category", "title", "question", "correctValue", "stars"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "true-false" },
              "category": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "figure": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" },
              "question": { "type": "string" },
              "correctValue": { "type": "boolean" },
              "stars": { "type": "integer", "minimum": 1 },
              "userIds": { "type": "array", "items": { "type": "string" }, "description": "If set, only these user IDs can play this exercise. If omitted, all users can play." },
              "template": { "type": "boolean" },
              "source": { "type": "string", "description": "Where in the textbooks it comes from" },
              "generatorParams": { "type": "object" }
            }
          },
          {
            "title": "Fill in the Blank",
            "type": "object",
            "required": ["id", "type", "category", "title", "textWithGaps", "options", "correctAnswers", "stars"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "fill-blank" },
              "category": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "figure": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" },
              "textWithGaps": { "type": "string" },
              "options": {
                "type": "array",
                "items": { "type": "string" }
              },
              "correctAnswers": {
                "type": "array",
                "items": { "type": "string" }
              },
              "stars": { "type": "integer", "minimum": 1 },
              "userIds": { "type": "array", "items": { "type": "string" }, "description": "If set, only these user IDs can play this exercise. If omitted, all users can play." },
              "template": { "type": "boolean" },
              "source": { "type": "string", "description": "Where in the textbooks it comes from" },
              "generatorParams": { "type": "object" }
            }
          },
          {
            "title": "Number Input",
            "type": "object",
            "required": ["id", "type", "category", "title", "question", "correctValue", "stars"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "number-input" },
              "category": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "figure": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" },
              "question": { "type": "string" },
              "correctValue": { "type": "number" },
              "stars": { "type": "integer", "minimum": 1 },
              "userIds": { "type": "array", "items": { "type": "string" }, "description": "If set, only these user IDs can play this exercise. If omitted, all users can play." },
              "template": { "type": "boolean" },
              "source": { "type": "string", "description": "Where in the textbooks it comes from" },
              "generatorParams": { "type": "object" }
            }
          },
          {
            "title": "Problem",
            "description": "A word problem solved in steps (see ProblemExercise in shared/types.ts)",
            "type": "object",
            "required": ["id", "type", "category", "title", "story", "steps", "stars"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "problem" },
              "category": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" },
              "figure": { "$ref": "data.schema.json#/properties/tasks/items/properties/icon" },
              "story": { "type": "string", "minLength": 1, "description": "The problem text. Phrases the tag step asks about are marked [phrase|known], [phrase|sought] or [phrase|extra]" },
              "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/problemStep" } },
              "source": { "type": "string", "description": "Where in the textbooks it comes from" },
              "stars": { "type": "integer", "minimum": 1 },
              "userIds": { "type": "array", "items": { "type": "string" }, "description": "If set, only these user IDs can play this exercise. If omitted, all users can play." },
              "template": { "type": "boolean" },
              "generatorParams": { "type": "object" }
            }
          }
        ]
      }
    }
  }
}

# Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Frontend listening port (production)
# Default: 80 (HTTP)
FRONTEND_PORT=80

# Ngrok authentication token (required for tunnel service)
# Obtain from https://dashboard.ngrok.com/auth
NGROK_AUTHTOKEN=replace-with-your-token

# Optional: reserve a domain or edge (paid tiers)
# NGROK_DOMAIN=your-custom-domain.ngrok-free.app
# NGROK_EDGE=edghts_1234567890abcdef

# Daily backup of the family's data (see BACKUP.md): the database, data.json,
# exercises.json and uploads/, with SHA256SUMS.
# BACKUP_DIR is the folder ON THE HOST; docker compose interpolates it into the
# backend's volume (mounted at /backups inside). Point it at a USB disk or NAS
# that is mounted at boot (fstab, nofail). Unset, backups go to ./backups/daily
# on the SD card, and the backend warns that they share its filesystem.
# BACKUP_DIR=/mnt/usb/routine-backups
# How many daily backups to keep (default 14)
# BACKUP_KEEP=14
# When to take it, cron syntax in the container's TZ (default 03:17 every day)
# BACKUP_CRON=17 3 * * *
# Seconds a backup may run before it is killed and logged as BACKUP_FAILED, so a
# disk or share that hangs for good never stops the daily backups (default 2 h)
# BACKUP_TIMEOUT=7200

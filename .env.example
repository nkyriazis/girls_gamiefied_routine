# Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Frontend listening port (production)
# Default: 80 (HTTP)
FRONTEND_PORT=80

# Ngrok authentication token (required for tunnel service)
# Obtain from https://dashboard.ngrok.com/auth
NGROK_AUTHTOKEN=replace-with-your-token

# Optional: reserve a domain or edge (paid tiers)
# NGROK_DOMAIN=your-custom-domain.ngrok-free.app
# NGROK_EDGE=edghts_1234567890abcdef

# LLM Service Configuration
# OpenAI API Key (for GPT models and embeddings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default LLM Provider (openai or anthropic)
DEFAULT_LLM_PROVIDER=openai

# Default Model to use
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
DEFAULT_MODEL=gpt-4o-mini

